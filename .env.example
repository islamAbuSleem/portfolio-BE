# ---------------------------------------------------------------------------
# portfolio-BE — environment template
# Copy to `.env` for local development. NEVER commit a filled-in `.env`.
# On Render, set these as Environment Variables in the dashboard.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Render injects PORT automatically. Locally 4000 matches the Next.js rewrite.
PORT=4000

# --- Database (Neon) -------------------------------------------------------
# Runtime: use the POOLED connection string (host contains "-pooler").
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migrations: use the DIRECT connection string (host has no "-pooler").
#   postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# Run `npm run db:deploy` with the DIRECT url, keep the POOLED url in the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional pool tuning (defaults are already sensible for the free tiers).
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# --- CORS / public URLs ----------------------------------------------------
# Comma-separated allow-list of browser origins that may call this API.
# The portfolio Worker origin MUST be listed exactly, including the scheme.
FRONTEND_URL=http://localhost:3000,https://portfolio.example.workers.dev

# Canonical public frontend URL, used to build magic-link emails.
# Must be a single origin (no comma-separated list).
APP_URL=http://localhost:3000

# Optional. Leave empty for host-only cookies (recommended: the Worker
# proxies /api/* so cookies stay first-party on the frontend origin).
COOKIE_DOMAIN=

# Number of reverse-proxy hops to trust for req.ip / X-Forwarded-Proto.
# Render sits behind one proxy, so 1 is correct in production.
TRUST_PROXY=1

# --- Email (magic link) ----------------------------------------------------
# Only needed if you use the passwordless login flow.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@example.com

# --- Seed ------------------------------------------------------------------
# Password for the seeded admin account (admin@example.com). Change it.
SEED_ADMIN_PASSWORD=change-me-before-seeding
