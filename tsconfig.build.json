{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the output root to ./src so the build emits dist/main.js.
    // Without this, prisma.config.ts (which lives outside src) widens the
    // inferred root and the output lands in dist/src/main.js, where
    // `node dist/main` cannot find it.
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "prisma.config.ts",
    "prisma/seed.ts"
  ]
}
